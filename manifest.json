{
  "manifest_version": 3,
  "name": "GMUDERs v2 - TOPdesk AI Form Filler",
  "version": "2.0.0",
  "description": "Preenchimento inteligente de GMUDs, Requisições de Mudança e chamados no TOPdesk via JSON de I.A.",
  "permissions": [
    "activeTab",
    "clipboardRead"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.topdesk.net/*",
        "*://*/tas/*",
        "*://*/*topdesk*/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "GMUDERs v2"
  }
}
